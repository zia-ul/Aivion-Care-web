# ---------------------------------------------------------------------------
# Aivion Care - web (Next.js) environment
#
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Backend origin - THE ONE LINE to change between dev and production.
#
#   development: http://localhost:8080
#   production : https://api.aivioncare.aiconfidencecure.com
#
# This also drives the WebSocket client (the scheme is rewritten to ws/wss), so
# there is no second value to keep in sync.
#
# Scheme + host only, no trailing slash and no /api path - endpoints append
# /api/v1/... themselves.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so
# switching environments means editing this and REBUILDING. Setting it as a
# runtime variable has no effect. Production must use https:// or the browser
# will block every request as Mixed Content.
NEXT_PUBLIC_API_URL=http://localhost:8080

# TURN/STUN for WebRTC calls. Uncomment to enable relay for restrictive NATs.
# NEXT_PUBLIC_TURN_URL=turn:turn.aiconfidencecure.com:3478
# NEXT_PUBLIC_TURN_USERNAME=your-turn-username
# NEXT_PUBLIC_TURN_CREDENTIAL=your-turn-credential

# Web push (VAPID) for notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact form delivery through Resend
RESEND_API_KEY=re_your_api_key
CONTACT_FROM_EMAIL=Aivion Care <onboarding@resend.dev>
SUPPORT_EMAIL=support@aiconfidencecure.com

# Contact form routing. The form picks a mailbox from the subject, so each team
# gets what it can act on: hr for applications, sales for pricing/partnerships,
# info for general and privacy/legal, and support for everything else.
# These are optional - the defaults are the four published addresses in
# src/lib/contact-emails.ts. Override only if a team uses a different alias.
# CONTACT_EMAIL_INFO=info@aiconfidencecure.com
# CONTACT_EMAIL_HR=hr@aiconfidencecure.com
# CONTACT_EMAIL_SALES=sales@aiconfidencecure.com
# CONTACT_EMAIL_SUPPORT=support@aiconfidencecure.com